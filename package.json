{
  "name": "tma-erp-q",
  "version": "1.0.0",
  "description": "Telegram Mini App ERP для управления качеством",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node check-installation.js",
    "verify": "node scripts/verify-setup.js",
    "migrate:make": "knex migrate:make",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "seed:make": "knex seed:make",
    "seed:run": "knex seed:run",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker/docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker/docker-compose.dev.yml logs -f",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "audit:force": "npm audit fix --force",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "db:reset": "rm -f dev.sqlite3 && npm run migrate:latest && npm run seed:run",
    "api:test": "node scripts/test-api.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.398.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^2.4.2",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "node-telegram-bot-api": "^0.61.0",
    "pg": "^8.11.3",
    "sqlite3": "^5.1.6",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.20.8"
  },
  "keywords": [
    "telegram",
    "erp",
    "quality-management",
    "production",
    "otk"
  ],
  "author": "TMA Team",
  "license": "MIT"
}
