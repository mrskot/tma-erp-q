# ============================================
# TMA-ERP-Q Development Environment
# ============================================

# Application
NODE_ENV=development
PORT=3000
JWT_SECRET=dev-jwt-secret-key-for-development-only

# Database - SQLite for simple development
DB_CLIENT=sqlite3
DB_CONNECTION_FILENAME=./dev.sqlite3

# File Storage - Local filesystem
USE_LOCAL_STORAGE=true
LOCAL_UPLOAD_DIR=./uploads

# Telegram
TELEGRAM_BOT_TOKEN=dev-fake-bot-token
USE_FAKE_TELEGRAM_AUTH=true

# Application Settings
REQUIRE_PHOTO_FOR_APPLICATION=false
REQUIRE_PHOTO_FOR_DISCREPANCY=false
DEFAULT_SLA_HOURS=24
PIN_CODE_LENGTH=4

# Logging
LOG_LEVEL=debug
LOG_TO_FILE=false

# Security
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Development
DEBUG=true
ENABLE_TEST_ROUTES=true